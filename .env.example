# Autopilon environment configuration (Phase 18 §3).
#
# NEVER commit a real .env file — this is a template only. Copy it to .env
# and fill in real values locally; in staging/production, set these in your
# hosting platform's own secret manager (see DEPLOYMENT_RUNBOOK.md), never
# in a file that gets committed.
#
# Vars are grouped by when they're needed:
#   [REQUIRED IN PRODUCTION]   - server refuses to boot without these
#                                 (server/config/env.js validates this)
#   [RECOMMENDED IN PRODUCTION] - app boots, but a real feature area is
#                                 degraded or unreachable without it
#   [OPTIONAL]                  - a specific integration/provider; the app
#                                 works fully without it, that one feature
#                                 just reports "not configured"
#   [DEV-ONLY]                  - only meaningful for local development

# ============================================================
# Core server
# ============================================================

# [OPTIONAL, has a default] Port the server listens on.
PORT=4000

# [OPTIONAL, has a default: <server>/app.sqlite] Where the SQLite database
# file lives. Override this to point at a mounted volume in a container
# deployment, so the database survives the container being recreated.
DB_PATH=

# development | staging | production — controls CORS strictness, cookie
# `secure` flag, and which env vars server/config/env.js enforces as
# required. Leave unset (or "development") for local dev.
NODE_ENV=development

# [OPTIONAL, has a default: memory] memory | redis. The default MemoryStore
# leaks memory over time, loses every session on a restart/deploy, and only
# works with exactly one server process — express-session's own README
# says not to use it in production. Set to "redis" (with REDIS_URL set
# below) for a real, restart-durable, multi-process-safe session store.
SESSION_STORE=memory

# [REQUIRED IN PRODUCTION] Session cookie signing secret. Must be a random
# string of at least 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A weak/default value lets an attacker forge session cookies for any user.
# In development this silently falls back to an insecure default; the
# server refuses to boot in production without a real one.
SESSION_SECRET=change-me-to-a-long-random-string

# [REQUIRED IN PRODUCTION] Encrypts secrets-at-rest: BYOK provider keys and
# developer webhook signing secrets (server/orchestrator/secretsCrypto.js).
# Any passphrase works — it's hashed into a proper AES-256 key internally.
# Generate one the same way as SESSION_SECRET above.
BYOK_ENCRYPTION_KEY=

# [RECOMMENDED IN PRODUCTION] Your real frontend origin(s), e.g.
# https://app.example.com. Without this, CORS falls back to reflecting
# whatever Origin header the request sent — fine for local dev (client and
# server are same-origin via the Vite proxy), a real gap in production.
# Comma-separate multiple origins if the web app is served from more than
# one (e.g. a staging domain + a marketing domain that embeds it).
CLIENT_ORIGIN=

# [RECOMMENDED IN PRODUCTION] Your app's own public base URL, e.g.
# https://app.example.com. Used to build webhook/callback URLs shown to
# users (e.g. the Shopify webhook registration flow) and as the default
# OAuth redirect base if a provider-specific redirect URI isn't set below.
APP_BASE_URL=

# [RECOMMENDED IN PRODUCTION] Whichever email matches this becomes a
# platform admin (Admin Panel, feature flags, platform-wide analytics) the
# next time they sign up or log in — there is no other way to become one.
PLATFORM_ADMIN_EMAIL=

# Set to "false" to close public signup (e.g. before billing is wired up,
# or during a closed beta) — existing accounts still work, only new
# self-signups are blocked. PLATFORM_ADMIN_EMAIL is always exempt, so the
# operator can still bootstrap their own admin account. Unset/anything
# else = signup stays open (default, unchanged behavior).
PUBLIC_SIGNUP_ENABLED=

# ============================================================
# AI providers — set the key matching AI_PROVIDER at minimum
# ============================================================

# [RECOMMENDED IN PRODUCTION — the chosen provider's key is effectively
# required] Choose one: anthropic | openai | gemini
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# [OPTIONAL] Web search. Choose one: tavily | brave | serpapi
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# [OPTIONAL] Voice (speech-to-text / text-to-speech). Reuses OPENAI_API_KEY
# above by default — no separate key needed unless you add another
# provider later.
STT_PROVIDER=openai
TTS_PROVIDER=openai
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ============================================================
# Integrations (each OPTIONAL — that integration just stays
# "not connected" without its credentials; nothing else breaks)
# ============================================================

# Meta Ads + WhatsApp Business — create your own app at
# developers.facebook.com. See PHASE4_NOTES.md / PHASE5_NOTES.md.
# In staging/production, META_REDIRECT_URI must be a real HTTPS URL
# registered in the Meta App's OAuth settings — see DEPLOYMENT_RUNBOOK.md.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v19.0
WHATSAPP_API_VERSION=v19.0
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-metas-webhook-setup

# Gmail / Google Calendar / Drive / Docs / Sheets — create credentials at
# console.cloud.google.com. See PHASE7_NOTES.md. GOOGLE_REDIRECT_URI must
# be a real HTTPS URL registered in the OAuth consent screen for
# staging/production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Shopify (custom app manual token — no OAuth needed for a single store).
SHOPIFY_WEBHOOK_SECRET=

# WordPress / WooCommerce use per-site application passwords entered
# directly in the app's Integrations page — no platform-wide env var needed.

# ============================================================
# Billing (Stripe) — OPTIONAL, but if set both keys are required together
# ============================================================

# Get keys from dashboard.stripe.com — use TEST mode keys in dev/staging.
# The webhook secret comes from creating an endpoint at
# dashboard.stripe.com/webhooks pointing to <APP_BASE_URL>/api/stripe/webhook,
# listening for: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# Mobile push notifications — OPTIONAL
# ============================================================

# Create a Firebase project at console.firebase.google.com, then Project
# settings -> Service accounts -> Generate new private key. Paste the
# ENTIRE downloaded JSON file's contents here as one line. Leave blank to
# leave push notifications disabled — everything else still works.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================================
# File storage (Phase 14 / Phase 18 §12)
# ============================================================

# [OPTIONAL, has a default] local | s3
# "local" writes to server/uploads/files/ on this machine's disk — fine for
# a single-instance dev/staging deploy, WRONG for any multi-instance or
# ephemeral-filesystem production deployment (files vanish on redeploy and
# aren't shared across instances). Use "s3" in production.
STORAGE_PROVIDER=local

# Required if STORAGE_PROVIDER=s3. Works with real AWS S3 or any
# S3-compatible host (Cloudflare R2, Backblaze B2, MinIO, etc.).
S3_BUCKET=
S3_REGION=auto
# Leave unset for real AWS S3. Set to your provider's endpoint for
# S3-compatible hosts, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Set to "true" for path-style hosts (most S3-compatible providers, incl. R2/MinIO).
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================================
# Redis — distributed cache / rate limiting / job queue (Phase 18 §7/§9)
# ============================================================

# [OPTIONAL, has a default] in_process | redis. "in_process" keeps cache
# state in this server's own memory — correct for exactly one running
# instance, wrong the moment you run more than one (each instance would
# have its own, inconsistent cache). Use "redis" for any multi-instance
# deployment.
CACHE_PROVIDER=in_process

# [OPTIONAL, has a default] in_memory | redis. Same reasoning as
# CACHE_PROVIDER — an in-memory rate limiter under-counts across more than
# one process.
RATE_LIMIT_PROVIDER=in_memory

# [OPTIONAL, has a default] in_process | redis. The in-process/SQLite queue
# (jobs table, WAL mode) is durable and — because WAL mode supports
# multiple OS processes on the same file — already works correctly with
# more than one server/worker.js process pointed at the same app.sqlite;
# that's the recommended path for real horizontal *job-processing* scaling
# on a single machine/disk. "redis" is a real, separately-tested adapter
# (jobs/queueProvider.js's RedisQueueProvider) for genuinely distributed
# (multi-machine) deployments, but is NOT wired into the Job Manager's
# default call path — see queueProvider.js's file-level comment for why.
QUEUE_PROVIDER=in_process

# [OPTIONAL, has a default: true] Set to "false" on the API server once one
# or more standalone `node worker.js` processes are running and handling
# jobs — otherwise the API server's own inline processor and the external
# worker(s) both poll the same queue (safe, just redundant). Irrelevant to
# worker.js itself, which always processes jobs regardless of this var.
RUN_INLINE_JOB_PROCESSOR=true

# [OPTIONAL, has a default] How often worker.js polls for new jobs, in ms.
WORKER_POLL_INTERVAL_MS=3000

# Required if any of the three *_PROVIDER vars above is set to "redis".
# redis://[:password@]host:port[/db] or rediss:// for TLS.
REDIS_URL=redis://localhost:6379

# ============================================================
# Client (Vite) — [DEV-ONLY]
# ============================================================
# During dev the client proxies /api to the server (see vite.config.js) —
# no env var needed. In production the built client is served as static
# files by the same server process (server/index.js), also with no
# separate client-side env var required, since it's same-origin.
