# ---- Server ----
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string

# AI provider abstraction. Choose one: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Only the key for the chosen provider is required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Web search (Phase 3). Choose one: tavily | brave | serpapi
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Meta Ads (Phase 4). Create your own app at developers.facebook.com —
# see README/PHASE4_NOTES.md for the exact setup steps and caveats.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v19.0

# WhatsApp Business (Phase 5). Uses the same Meta App as Meta Ads for
# webhook signature verification (META_APP_SECRET above is reused).
# See PHASE5_NOTES.md for exact setup steps.
WHATSAPP_API_VERSION=v19.0
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-metas-webhook-setup

# Gmail (Phase 7). Create credentials at console.cloud.google.com —
# see PHASE7_NOTES.md for exact setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Shopify (custom app manual token — no OAuth needed for a single store).
# Create a custom app in Shopify Admin → Settings → Apps and sales channels
# → Develop apps, grant it the scopes you need, and use its Admin API
# access token when connecting in the app's Integrations page.
SHOPIFY_WEBHOOK_SECRET=
# Your app's own public URL (e.g. your Codespace's forwarded https URL).
# Only needed if you use shopify.register_webhook to wire up automation
# triggers — Shopify needs a real address to send webhook events to.
APP_BASE_URL=

# ---- Client ----
# During dev the client proxies /api to the server (see vite.config.js).
