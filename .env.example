# ---- Server ----
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string

# AI provider abstraction. Choose one: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Only the key for the chosen provider is required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Web search (Phase 3). Choose one: tavily | brave | serpapi
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Meta Ads (Phase 4). Create your own app at developers.facebook.com —
# see README/PHASE4_NOTES.md for the exact setup steps and caveats.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v19.0

# WhatsApp Business (Phase 5). Uses the same Meta App as Meta Ads for
# webhook signature verification (META_APP_SECRET above is reused).
# See PHASE5_NOTES.md for exact setup steps.
WHATSAPP_API_VERSION=v19.0
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-metas-webhook-setup

# Gmail (Phase 7). Create credentials at console.cloud.google.com —
# see PHASE7_NOTES.md for exact setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Shopify (custom app manual token — no OAuth needed for a single store).
# Create a custom app in Shopify Admin → Settings → Apps and sales channels
# → Develop apps, grant it the scopes you need, and use its Admin API
# access token when connecting in the app's Integrations page.
SHOPIFY_WEBHOOK_SECRET=
# Your app's own public URL (e.g. your Codespace's forwarded https URL).
# Only needed if you use shopify.register_webhook to wire up automation
# triggers — Shopify needs a real address to send webhook events to.
APP_BASE_URL=

# Phase 10 billing. Required only if an organization wants to bring its own
# AI provider key (BYOK) instead of using the platform's. Any passphrase
# works — it's hashed into a proper encryption key internally. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOK_ENCRYPTION_KEY=

# Phase 10: whichever email matches this becomes a platform admin (can
# create coupons, will get the future Admin Panel) the next time they sign
# up or log in — there's no self-service way to become one otherwise.
PLATFORM_ADMIN_EMAIL=

# Phase 10 Stripe. Get keys from dashboard.stripe.com — use TEST mode keys
# while developing. The webhook secret comes from creating an endpoint at
# dashboard.stripe.com/webhooks pointing to <your public URL>/api/stripe/webhook,
# listening for: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 12D mobile push notifications. Create a Firebase project at
# console.firebase.google.com, then Project settings → Service accounts →
# Generate new private key — that downloads a JSON file. Paste its ENTIRE
# contents here as one line (no line breaks). Leave blank to leave push
# notifications disabled — everything else still works fine without it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Phase 13 voice (speech-to-text / text-to-speech). Reuses OPENAI_API_KEY
# above — no separate key needed for the default provider. STT_PROVIDER and
# TTS_PROVIDER only need to be set if you add another provider later; leave
# blank to use OpenAI (Whisper + TTS).
STT_PROVIDER=openai
TTS_PROVIDER=openai
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ---- Client ----
# During dev the client proxies /api to the server (see vite.config.js).
